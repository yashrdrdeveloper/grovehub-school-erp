frontend/projects/*/.env.local

# Consumer-local generated OpenAPI SDKs
/backend/projects/school/internal/generated/
/backend/projects/internal-tool/internal/generated/

# Developer-local Go workspaces are not part of the build contract.
/go.work
/go.work.sum
