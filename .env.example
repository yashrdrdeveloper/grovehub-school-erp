# GroveHub application logging.
# Comma-separated exact-match list. Allowed values: DEBUG, INFO, WARN, ERROR.
# Example: ERROR,WARN emits only WARN and ERROR application logs.
GROVEHUB_LOG_LEVELS=ERROR,WARN

# Grafana Cloud OTLP credentials for local observability.
# Copy this file to .env and replace the placeholder values.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=replace-with-instance-id
GRAFANA_CLOUD_API_KEY=replace-with-new-api-key

# GroveHub OpenTelemetry resource identity.
OTEL_SERVICE_NAME=grovehub-platform
OTEL_SERVICE_NAMESPACE=grovehub
OTEL_DEPLOYMENT_ENVIRONMENT=local
