# GroveHub managed PostgreSQL connection.
# Development/testing uses the Aiven Service URI. Keep sslmode=require in the URI.
DATABASE_URL=

# GroveHub Mail Provider local SMTP submission transport.
# dev-start launches Haraka automatically and binds it only to localhost.
MAIL_PROVIDER_SMTP_HOST=127.0.0.1
MAIL_PROVIDER_SMTP_PORT=2525
HARAKA_MEMORY_LIMIT=512m
MAIL_PROVIDER_DKIM_SELECTOR=groovehub1

# Optional outbound SMTP relay for local/development environments where direct
# server-to-server SMTP (port 25) is unavailable. Leave HOST blank to keep
# Haraka's normal direct-MX delivery. Port 587 uses STARTTLS.
MAIL_PROVIDER_RELAY_HOST=
MAIL_PROVIDER_RELAY_PORT=587
MAIL_PROVIDER_RELAY_USERNAME=
MAIL_PROVIDER_RELAY_PASSWORD=
MAIL_PROVIDER_RELAY_TLS=true

# Cloudflare DNS automation used by `make mail-domain-ready`.
# Create an API token scoped to the sending zone with Zone:Read and DNS:Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional override. Leave blank to discover this machine's public IPv4 through Cloudflare.
MAIL_PROVIDER_PUBLIC_IP=

# GroveHub application logging.
# Comma-separated exact-match list. Allowed values: DEBUG, INFO, WARN, ERROR.
# Example: ERROR,WARN emits only WARN and ERROR application logs.
GROVEHUB_LOG_LEVELS=ERROR,WARN

# GroveHub tracing and metrics controls.
# Local development keeps 100% of traces. Production can lower this ratio later.
GROVEHUB_TRACE_SAMPLE_RATIO=1.0
# Metrics are exported periodically through the local OpenTelemetry collector.
GROVEHUB_METRIC_EXPORT_INTERVAL=15s

# Grafana Cloud OTLP credentials for local observability.
# Copy this file to .env and replace the placeholder values.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=replace-with-instance-id
GRAFANA_CLOUD_API_KEY=replace-with-new-api-key

# GroveHub OpenTelemetry resource identity.
# OTEL_SERVICE_NAME is only a collector fallback for records that do not carry a
# logical service identity. Application traces/metrics use LAUNCHER (EDGE),
# FOUNDATION, IDENTITY, MAIL PROVIDER, and future logical service names directly.
OTEL_SERVICE_NAME=launcher-edge
OTEL_SERVICE_NAMESPACE=grovehub
OTEL_SERVICE_VERSION=dev
OTEL_DEPLOYMENT_ENVIRONMENT=local
# Optional. Leave empty to use <hostname>-<pid> automatically.
OTEL_SERVICE_INSTANCE_ID=
