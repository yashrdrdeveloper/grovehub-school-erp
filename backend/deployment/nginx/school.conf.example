# Include inside the School HTTPS server block only.
root /opt/groovehub/school-frontend/current/payload;
index index.html;
client_max_body_size 1m;
# These four browser routes carry a one-time Recovery or Invitation proof.
# Preserve Authorization only here; School validates the scheme and translates
# the proof into the independently signed Platform workload request.
location ~ ^/identity/public/auth/(recovery|invitations)/(validate|exchange)$ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-GH-Identity-Proof "";
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 3s;
    proxy_read_timeout 35s;
    access_log off;
}
location ~ ^/(identity|audit|foundation|integrations)/(public|protected)(/|$) {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-GH-Identity-Proof "";
    proxy_set_header Authorization "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 35s;
}
# Deny every other API tier, cross-product route and private health probe.
location ~ ^/(identity|audit|foundation|integrations|integration|infrastructure|school|internal|health|ready)(/|$) {
    return 404;
}
location ~ ^/(\.env|\.git)(/|$) { return 404; }
location /assets/ { try_files $uri =404; }
location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
}
