GROOVEHUB_HTTP_ADDR=127.0.0.1:8082

# Dedicated database URI and non-superuser role; no Platform fallback.
INTERNAL_TOOL_DATABASE_URL=
INTERNAL_TOOL_ALLOWED_ORIGIN=http://127.0.0.1:4174

# Optional read-only catalog adapter. Leave all five empty to disable.
INTERNAL_TOOL_CATALOG_ENVIRONMENT=
INTERNAL_TOOL_CATALOG_TEMPLATE_ID=
INTERNAL_TOOL_PLATFORM_ORIGIN=
INTERNAL_TOOL_WORKLOAD_KEY_ID=
INTERNAL_TOOL_WORKLOAD_PRIVATE_KEY=

# Optional independent audit delivery. All empty retains local outbox only.
INTERNAL_TOOL_AUDIT_ORIGIN=
INTERNAL_TOOL_AUDIT_KEY_ID=
INTERNAL_TOOL_AUDIT_PRIVATE_KEY=

# Optional independent read-only operator audit search.
INTERNAL_TOOL_AUDIT_READ_ORIGIN=
INTERNAL_TOOL_AUDIT_READ_KEY_ID=
INTERNAL_TOOL_AUDIT_READ_PRIVATE_KEY=

# Optional single-school read-only audit-check binding; all values must be set together.
INTERNAL_TOOL_SCHOOL_ENVIRONMENT=
INTERNAL_TOOL_SCHOOL_TEMPLATE_ID=
INTERNAL_TOOL_SCHOOL_ID=
INTERNAL_TOOL_SCHOOL_ORIGIN=
INTERNAL_TOOL_SCHOOL_KEY_ID=
INTERNAL_TOOL_SCHOOL_PRIVATE_KEY=
INTERNAL_TOOL_SCHOOL_OPERATOR_IDS=
