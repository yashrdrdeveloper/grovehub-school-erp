GROOVEHUB_HTTP_ADDR=127.0.0.1:8081
PLATFORM_ORIGIN=http://127.0.0.1:8080
SCHOOL_ALLOWED_ORIGIN=http://127.0.0.1:4173
SCHOOL_WORKLOAD_KEY_ID=
SCHOOL_WORKLOAD_PRIVATE_KEY=

# Dedicated database URI and non-superuser role; no Platform fallback.
SCHOOL_DATABASE_URL=

# Optional JSON array of independently authorized directory readers (public keys only).
SCHOOL_REGISTRY_READ_GRANTS=

# Separate per-school rename workload public keys (JSON array of WorkloadKeyConfig).
SCHOOL_REGISTRY_RENAME_KEYS=

# Optional single-school committed rename receipt relay; separate private key.
SCHOOL_RECEIPT_ORIGIN=
SCHOOL_RECEIPT_SCHOOL_ID=
SCHOOL_RECEIPT_KEY_ID=
SCHOOL_RECEIPT_PRIVATE_KEY=

# JSON array of up to 100 {origin,schoolId,keyId,privateKey} publishers.
# Mutually exclusive with the single-school SCHOOL_RECEIPT_* settings above.
SCHOOL_RECEIPT_PUBLISHERS=

# Separate per-school registry status workload public keys.
SCHOOL_REGISTRY_STATUS_KEYS=

# Each SCHOOL_RECEIPT_PUBLISHERS entry may set operation: rename (default) or status.
# Configure distinct keys per school and operation.
