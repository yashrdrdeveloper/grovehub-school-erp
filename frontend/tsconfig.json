{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@Base/*": [
        "packages/base/*"
      ],
      "@Business/*": [
        "packages/business/*"
      ],
      "@Components/*": [
        "packages/components/*"
      ],
      "@Domain/*": [
        "packages/domain/*"
      ],
      "@Auth/*": [
        "packages/auth/*"
      ],
      "@Shell/*": [
        "packages/shell/*"
      ]
    }
  },
  "include": [
    "app",
    "packages",
    "vite.config.ts"
  ]
}
