{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@Base/*": [
        "../../libs/base/*"
      ],
      "@Components/*": [
        "../../libs/components/*"
      ],
      "@Styles/*": [
        "../../libs/styles/*"
      ]
    }
  },
  "include": [
    "app",
    "packages",
    "vite.config.ts",
    "../../libs/components/types/i18n.global.d.ts"
  ]
}
