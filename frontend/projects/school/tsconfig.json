{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "jest"
    ],
    "baseUrl": ".",
    "paths": {
      "@Base/*": [
        "../libs/frontend/base/*"
      ],
      "@Business/*": [
        "packages/business/*"
      ],
      "@Components/*": [
        "../libs/frontend/components/*"
      ],
      "@Domain/*": [
        "packages/domain/*"
      ],
      "@Shell/*": [
        "packages/shell/*"
      ],
      "@Base": [
        "../libs/frontend/base/index.ts"
      ],
      "@Business": [
        "packages/business/index.ts"
      ],
      "@Components": [
        "../libs/frontend/components/index.ts"
      ],
      "@Domain": [
        "packages/domain/index.ts"
      ],
      "@Shell": [
        "packages/shell/index.ts"
      ],
      "@Styles": [
        "../libs/frontend/styles/index.ts"
      ],
      "@Styles/*": [
        "../libs/frontend/styles/*"
      ],
      "@Assets/*": [
        "packages/assets/*"
      ],
      "@Assets": [
        "packages/assets/index.ts"
      ]
    }
  },
  "include": [
    "app",
    "packages",
    "../libs/frontend/base",
    "../libs/frontend/styles",
    "../libs/frontend/components",
    "vite.config.ts"
  ]
}
